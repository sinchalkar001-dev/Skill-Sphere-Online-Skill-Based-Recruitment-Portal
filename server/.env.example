# ═══════════════════════════════════════════
#  Skill Sphere — Server Environment Config
# ═══════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/skill-sphere

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
SENDER_EMAIL=noreply@skillsphere.com
SENDER_NAME=Skill Sphere

# Email delivery: failed sends are retried with increasing waits (30s, 2m, 8m, 32m)
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=30000
EMAIL_WORKER_INTERVAL_MS=30000

# Rate limiting, per IP per window
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Performance
MONGODB_POOL_SIZE=20
AUTH_CACHE_TTL_MS=30000

# Reconcile indexes with the schemas on startup (default: on, except in production)
# SYNC_INDEXES=true
